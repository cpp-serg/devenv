# version.env — single source of truth for the Open5GS version this suite
# builds and installs.
#
# Bumping the version here is sufficient. Everything else follows:
#   build.sh        upstream tag (v$OPEN5GS_VERSION) and the BUILD mount path
#   entrypoint.sh   passes the values into open5gs.spec via rpmbuild --define
#   open5gs.spec    RPM Version:/Release:
#   install*.sh     BUILDROOT path and the upstream files fetched by tag
#
# Values are assigned with := so an explicit environment variable still wins:
#   OPEN5GS_VERSION=2.7.7 ./build.sh
#
# Note: patches/ must apply to the tag named here; build.sh fails loudly if not.

: "${OPEN5GS_VERSION:=2.8.0}"
: "${OPEN5GS_RELEASE:=1}"
